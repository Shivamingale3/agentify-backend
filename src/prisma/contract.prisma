// use prisma-8
model User {
  id        String    @id @default(ulid())
  firstName String?
  lastName  String?
  mobile    String?   @unique
  email     String    @unique
  password  String
  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now())

  @@map("users")
}

model Session {
  id        String    @id @default(ulid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  token     String
  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now())

  @@map("sessions")
}
