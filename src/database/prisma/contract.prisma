// use prisma-8
model User {
  id            String               @id @default(ulid())
  firstName     String?
  lastName      String?
  countryCode   String?
  mobile        String?              @unique
  email         String               @unique
  emailVerified Boolean              @default(false)
  password      String
  createdAt     DateTime?            @default(now())
  updatedAt     temporal.updatedAt()

  @@map("users")
}

model TemporaryTasks {
  id        String               @id @default(ulid())
  taskType  TemporaryTaskType    @default(EMAIL_VERIFICATION)
  token     String               @unique
  taskData  Json
  createdAt DateTime             @default(now())
  updatedAt temporal.updatedAt()
  expiresAt DateTime

  // The cleanup job deletes by expiresAt.
  @@index([expiresAt])
  @@map("temporary_tasks")
}

model Session {
  id         String               @id
  userId     String               @unique
  user       User                 @relation(fields: [userId], references: [id])
  token      String
  clientName String?
  clientType String?
  createdAt  DateTime?            @default(now())
  updatedAt  temporal.updatedAt()

  @@map("sessions")
}

enum TemporaryTaskType {
  EMAIL_VERIFICATION
}
