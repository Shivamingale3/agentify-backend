# APP_CONFIG
APP_ENV=development
APP_PORT=5000
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
# Comma separated list of frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_SECRET=
AUTH_EXPIRY=
REFRESH_EXPIRY=

# DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# EMAIL
EMAIL_HOST=smtp.zoho.in
EMAIL_PORT=587
EMAIL_FROM=Agentify<noreply@shivamingale.com>
EMAIL_USER=noreply@shivamingale.com
EMAIL_PASSWORD=

# CACHE
CACHE_URL=redis://localhost:6379
CACHE_PASS=your_redis_password

# QUEUE
QUEUE_HOST=localhost
QUEUE_PORT=6379
QUEUE_PASS=your_queue_password


# WORKER
# Jobs each worker process runs in parallel (default 5)
WORKER_CONCURRENCY=5
