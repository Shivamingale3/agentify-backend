{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "eslint", "import", "vitest"],
  "categories": { "correctness": "error", "suspicious": "error" },
  "env": { "node": true },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/restrict-template-expressions": ["error", { "allowNumber": true }],
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-extraneous-class": ["error", { "allowWithDecorator": true }],
    "no-restricted-imports": [
      "error",
      { "patterns": [{ "regex": "^\\.{1,2}/", "message": "Use the @/ alias" }] }
    ],
    "import/no-unassigned-import": [
      "error",
      { "allow": ["temporal-polyfill/**", "dotenv/config"] }
    ],
    "no-console": "off",
    "typescript/explicit-function-return-type": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "vitest/require-mock-type-parameters": "off"
  },
  "overrides": [
    {
      "files": ["**/*.spec.ts", "test/**"],
      "rules": { "no-console": "off", "typescript/explicit-function-return-type": "off" }
    }
  ],
  "ignorePatterns": ["src/database/prisma/**", ".claude/skills/**", ".agents/**", "migrations/**"]
}
