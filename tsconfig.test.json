{
  // Type-checks app + tests + tooling config. The build still uses tsconfig.json (src only).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src", "tests", "vitest.config.ts"]
}
