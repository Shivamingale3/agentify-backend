{
  "name": "agentify-api",
  "version": "0.0.1",
  "description": "API Backend for the Agentify project. Previously in plain nodejs-typescript-prisma with some custom middlewares, now re-written in NestJs.",
  "author": "Shivam Ingale (#Shivamingale3)",
  "private": false,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "dev": "nest start --watch",
    "start": "nest start",
    "debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "lint:fix": "oxlint --type-aware --fix src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --project e2e",
    "test:unit": "vitest run --project unit",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "prisma:generate": "prisma contract emit",
    "prisma:migrate": "prisma db migrate",
    "prisma:migrate:dev": "prisma migration plan && prisma db migrate",
    "db:push": "prisma db update",
    "dev:worker": "nest start --watch --entryFile worker",
    "start:worker": "node dist/worker"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/orm-postgres": "^8.0.0-rc.17",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.15",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.1.2",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "temporal-polyfill": "^1.0.6",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@prisma/cli-engine": "^0.7.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dotenv": "^18.0.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "^8.0.0-rc.22",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
